{smcl}
{com}{sf}{ul off}{txt}{.-}
      name:  {res}<unnamed>
       {txt}log:  {res}data/STATA\cholesterol part 2.smcl
  {txt}log type:  {res}smcl
 {txt}opened on:  {res}13 May 2026, 16:17:44
{txt}
{com}. 
. *import data
. import delimited "data/STATA\assignment 2_Number 2_2025_2026.csv", clear
{res}{txt}(encoding automatically selected: ISO-8859-2)
{text}(8 vars, 4,699 obs)

{com}. 
. *RENAME COLUMNS
. rename column1 sex
{res}{txt}
{com}. rename column2 sbp
{res}{txt}
{com}. rename column3 dbp
{res}{txt}
{com}. rename column4 chol
{res}{txt}
{com}. rename column5 age
{res}{txt}
{com}. rename column8 bmi
{res}{txt}
{com}. 
. label define sexlbl 1 "Male" 2 "Female"
{txt}
{com}. label values sex sexlbl
{txt}
{com}. 
. * Generate ordinal outcome
. gen chol_cat = .
{txt}(4,699 missing values generated)

{com}. replace chol_cat = 0 if chol < 200
{txt}(1,237 real changes made)

{com}. replace chol_cat = 1 if chol >= 200 & chol < 240
{txt}(1,752 real changes made)

{com}. replace chol_cat = 2 if chol >= 240
{txt}(1,710 real changes made)

{com}. 
. label define chollbl 0 "Healthy" 1 "Borderline High" 2 "High"
{txt}
{com}. label values chol_cat chollbl
{txt}
{com}. 
. * Verify
. tab chol_cat, missing

