. *COLLAPSE SPARSE CATEGORIES; 
. *History of premature labor acategories(ptl); 0=159, 1=24, 2=5, 3=1 → Collapse 2 and 3 into "2 or more"
. gen ptl2 = ptl
{txt}
{com}. recode ptl2 (2 3 = 2)
{txt}(1 changes made to {bf:ptl2})

{com}. label define ptl2_lbl 0 "No prior premature labor"  1 "One prior premature labor"   2 "Two or more prior premature labors"
{txt}
{com}. label values ptl2 ptl2_lbl
{txt}
{com}. tab ptl2

                              {txt}ptl2 {c |}      Freq.     Percent        Cum.
{hline 35}{c +}{hline 35}
