{txt}{hline 35}{c +}{hline 35}
                             Total {c |}{res}        189      100.00
{txt}
{com}. 
. * Number of Physician Visits During the First Trimester()ftv2: 0=100, 1=47, 2=30, 3=7, 4=4, 6=1 → Collapse 3, 4, 6 into "3 or more"
. gen ftv2 = ftv
{txt}
{com}. recode ftv2 (3 4 6 = 3)
{txt}(5 changes made to {bf:ftv2})

{com}. label define ftv2_lbl 0 "No physician visits" 1 "One physician visit" 2 "Two physician visits" 3 "Three or more physician visits"
{txt}
{com}. 
. 
. label values ftv2 ftv2_lbl
{txt}
{com}. tab ftv2

                          {txt}ftv2 {c |}      Freq.     Percent        Cum.
