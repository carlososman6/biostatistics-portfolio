* Set once: the folder that contains this repository, then run.
CD 'REPLACE-WITH-PATH/biostatistics-portfolio'.
GET FILE='data/raw/hwg.sav'.
DATASET NAME DataSet0 WINDOW=FRONT.
* Encoding: UTF-8.

DATASET ACTIVATE DataSet0.
FREQUENCIES VARIABLES=Gender Height Weight
  /ORDER=ANALYSIS.

FREQUENCIES VARIABLES=Gender Height Weight
  /FORMAT=NOTABLE
  /BARCHART PERCENT
  /ORDER=ANALYSIS.

FREQUENCIES VARIABLES=Gender Height Weight
  /FORMAT=NOTABLE
  /STATISTICS=STDDEV VARIANCE MINIMUM MAXIMUM SEMEAN MEAN
  /HISTOGRAM NORMAL
  /ORDER=ANALYSIS.

MEANS TABLES=Height BY Gender
  /CELLS=MEAN COUNT STDDEV.

DESCRIPTIVES VARIABLES=Gender Height Weight
  /STATISTICS=MEAN STDDEV MIN MAX.

EXAMINE VARIABLES=Height Weight
  /PLOT BOXPLOT STEMLEAF HISTOGRAM
  /COMPARE GROUPS
  /PERCENTILES(5,10,25,50,75,90,95) HAVERAGE
  /STATISTICS DESCRIPTIVES EXTREME
  /CINTERVAL 95
  /MISSING LISTWISE
  /NOTOTAL.

EXAMINE VARIABLES=Height Weight BY Gender
  /PLOT BOXPLOT STEMLEAF HISTOGRAM
  /COMPARE GROUPS
  /PERCENTILES(5,10,25,50,75,90,95) HAVERAGE
  /STATISTICS DESCRIPTIVES EXTREME
  /CINTERVAL 95
  /MISSING LISTWISE
  /NOTOTAL.

DESCRIPTIVES VARIABLES=Height Weight
  /SAVE
  /STATISTICS=MEAN STDDEV MIN MAX.

CORRELATIONS
  /VARIABLES=Height Weight
  /PRINT=TWOTAIL NOSIG FULL
  /MISSING=PAIRWISE.

CORRELATIONS
  /VARIABLES=Height Weight Gender
  /PRINT=TWOTAIL NOSIG FULL
  /MISSING=PAIRWISE.

* Chart Builder.
GGRAPH
  /GRAPHDATASET NAME="graphdataset" VARIABLES=Height Weight MISSING=LISTWISE REPORTMISSING=NO
  /GRAPHSPEC SOURCE=INLINE
  /FITLINE TOTAL=NO SUBGROUP=NO.
BEGIN GPL
  SOURCE: s=userSource(id("graphdataset"))
  DATA: Height=col(source(s), name("Height"))
  DATA: Weight=col(source(s), name("Weight"))
  GUIDE: axis(dim(1), label("Height in inches"))
  GUIDE: axis(dim(2), label("Weight in pounds"))
  GUIDE: text.title(label("Scatter Plot of Weight in pounds by Height in inches"))
  ELEMENT: point(position(Height*Weight))
END GPL.

T-TEST
  /TESTVAL=65
  /MISSING=ANALYSIS
  /VARIABLES=Height
  /ES DISPLAY(TRUE)
  /CRITERIA=CI(.95).

T-TEST PAIRS=Height WITH Weight (PAIRED)
  /ES DISPLAY(TRUE) STANDARDIZER(SD)
  /CRITERIA=CI(.9500)
  /MISSING=ANALYSIS.

T-TEST GROUPS=Gender(1 2)
  /MISSING=ANALYSIS
  /VARIABLES=Height Weight
  /ES DISPLAY(TRUE)
  /CRITERIA=CI(.95).
